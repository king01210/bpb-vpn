<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash screen. Without a splash icon it shows the launcher icon,
         background and all, in a circle; the icon's foreground layer (no background) fits the
         splash icon's 288 dp canvas / 192 dp circle the same way. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
